<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>KnightInCradle</AssemblyName>
    <RootNamespace>KnightInCradle</RootNamespace>
    <Version>0.2.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <!--
      AIC 游戏根目录（引用它的 Managed DLL 与 BepInEx core）。
      KIC 的 Harmony 补丁必须和“目标安装的游戏程序集”配套编译，否则运行时会
      出现 `[KIC][补丁] … N 失败（HarmonyException: IL Compile Error）`。
      默认按新版 0.30g 编译；给别的版本编译时用：
        dotnet build -c Release -p:AicRoot="<那个安装的游戏根目录>"
      编译目标会写进 DLL（AssemblyMetadata: AicCompileTarget），启动日志会打印，
      方便确认“手上这份 DLL 到底配哪个游戏版本”。
    -->
    <AicRoot Condition="'$(AicRoot)' == ''">D:\Documents\AliceInCradle\AIC_MP\AliceInCradle Win ver030\AliceInCradle_ver030</AicRoot>
    <AicAsmPath Condition="'$(AicAsmPath)' == ''">$(AicRoot)\AliceInCradle_Data\Managed\Assembly-CSharp.dll</AicAsmPath>
    <!-- 注意：MSBuild 的属性函数不允许 File.ReadAllBytes，所以这里只记录文件时间；
         大小在运行时由 RuntimeGameAssemblyStamp() 打印，用来互相对照。 -->
    <AicAsmTime Condition="Exists('$(AicAsmPath)')">$([System.IO.File]::GetLastWriteTime('$(AicAsmPath)').ToString('yyyy-MM-dd HH:mm'))</AicAsmTime>
    <AicCompileTarget>$(AicAsmTime) / $(AicRoot)</AicCompileTarget>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AicCompileTarget</_Parameter1>
      <_Parameter2>$(AicCompileTarget)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- 引用的游戏程序集不存在时给一条能看懂的报错（否则会是一堆 CS0246） -->
  <Target Name="CheckAicRoot" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AicAsmPath)')"
           Text="找不到游戏程序集 $(AicAsmPath)。请用 -p:AicRoot=&quot;&lt;目标游戏根目录&gt;&quot; 指定要适配的安装（该目录需含 AliceInCradle_Data\Managed\Assembly-CSharp.dll）。KIC 的 DLL 必须与目标安装的游戏程序集配套编译。" />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="unsafeAssem">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\unsafeAssem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="pixelliner">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\pixelliner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(AicRoot)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(AicRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(AicRoot)\AliceInCradle_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="reference\**" />
    <None Remove="reference\**" />
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Compile Remove="_decomp\**" />
    <None Remove="_decomp\**" />
  </ItemGroup>

  <ItemGroup>
